[Unit]
Description=Check 1C backup health and integrity
Wants=network-online.target
After=network-online.target one-c-backup.service

[Service]
Type=oneshot
User=vboxuser
Group=vboxuser

# Имя контейнера PostgreSQL — переопределить при необходимости
Environment=PG_CONTAINER=postgres-1c

ExecStart=/usr/local/bin/check_1c_backup.sh

TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
