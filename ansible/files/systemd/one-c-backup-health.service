
[Unit]
Description=Check 1C backup health and integrity
Wants=network-online.target
After=network-online.target one-c-backup.service

[Service]
Type=oneshot
User=vboxuser
Group=vboxuser

ExecStart=/usr/local/bin/check_1c_backup.sh

# Не считаем ошибкой проверки сбой системы — наоборот,
# хотим ненулевой код, чтобы мониторинг сработал
SuccessExitStatus=0
TimeoutStartSec=300

# Логи в journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
