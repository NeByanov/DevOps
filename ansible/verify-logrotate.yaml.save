- name: Check configuration
  hosts: lab_vm
  gather_facts: false
  tasks:

    - name: Check Taimer enabled
      ansible.builtin.command: systemctl is-enabled logrotate.timer
      register: timer_enabled
      changed_when: false
      failed_when: false

    - name: Taimer logrotate active
      ansible.builtin.command: systemctl is-active logrotate.timer
      register: timer_active
      changed_when: false
      failed_when: false



    - name: collect rules
      ansible.builtin.stat:
        path: /etc/logrotate.d/site-backup
      register: rule_stat

    - name: rules entity
      ansible.builtin.assert:
        that: rule_stat.stat.exists
        msg: "Правило /etc/logrotate.d/site-backup отсутствует"

    - name: owner check
      ansible.builtin.assert:
        that:
          - rule_stat.stat.mode == "0644"
        fail_msg: "Неверные права или владелец правила"
        success_msg: "Права и владелец верны"
    - name: Collect logs
      ansible.builtin.stat:
        path: "{{ site_backup_log_path }}"
      register: log_stat

    - name: log exitst
      ansible.builtin.assert:
        that: log_stat.stat.exists
        msg: "Лог /var/log/vbox/backupdb.log отсутствует"

    - name: Dry-run check logrotate
      ansible.builtin.command: logrotate -d /etc/logrotate.d/site-backup
      changed_when: false
      failed_when: logrotate_dry_run.rc != 0
      register: logrotate_dry_run
